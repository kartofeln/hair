# Configuración de credenciales y secretos
[api]
# Credenciales de DataForSEO (si se necesitan)
dataforseo_username = "your_username_here"
dataforseo_password = "your_password_here"

# Configuración de la aplicación
[app]
title = "Análisis de Competidores - Cuidado Capilar"
description = "Dashboard interactivo para análisis de mercado"
theme = "light"
primary_color = "#FF4B4B"
secondary_color = "#FFE4E4"
font = "sans serif"

# Configuración de caché
[cache]
ttl = 3600  # Tiempo de vida de la caché en segundos
max_entries = 100  # Número máximo de entradas en caché

# Configuración de seguridad
[security]
enable_cors = true
enable_xsrf_protection = true
enable_cookies = true 